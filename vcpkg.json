{
  "name": "neurograph",
  "version-string": "0.2.0",
  "description": "Desktop tool that trains, checks and exports prediction models from CSV files",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    "nlohmann-json",
    "spdlog",
    "gtest",
    "libsodium",
    "curl",
    {
      "name": "imgui",
      "features": ["docking-experimental", "dx11-binding", "win32-binding"]
    }
  ],
  "overrides": [
    { "name": "imgui",         "version": "1.92.7" },
    { "name": "curl",          "version": "8.19.0" },
    { "name": "fmt",           "version": "12.1.0" },
    { "name": "gtest",         "version": "1.17.0", "port-version": 3 },
    { "name": "libsodium",     "version": "1.0.21", "port-version": 1 },
    { "name": "nlohmann-json", "version": "3.12.0", "port-version": 2 },
    { "name": "spdlog",        "version": "1.17.0", "port-version": 1 }
  ]
}
